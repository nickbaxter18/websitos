{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CI Job Summary",
  "type": "object",
  "required": [
    "schema_version",
    "job_key",
    "status",
    "exit_code",
    "started_at",
    "completed_at",
    "duration_seconds",
    "environment",
    "metadata",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "job_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "warning", "skipped"]
    },
    "exit_code": {
      "type": "integer"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "required": ["os", "node_version"],
      "properties": {
        "os": { "type": "string" },
        "node_version": { "type": "string" },
        "docker_image": { "type": "string" },
        "browser": { "type": "string" },
        "runner": { "type": "string" }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "string" },
        "logs_size_bytes": { "type": "integer", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "warnings_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["tool", "version", "logs_size_bytes", "retry_count", "warnings_count"],
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "npm": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["npm"],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
