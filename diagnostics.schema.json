{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnostics Summary",
  "type": "object",
  "required": [
    "job",
    "status",
    "exit_code",
    "metadata",
    "environment",
    "dependencies"
  ],
  "properties": {
    "job": { "type": "string" },
    "status": { "type": "string", "enum": ["success", "failure", "warning", "skipped"] },
    "exit_code": { "type": "integer" },
    "metadata": {
      "type": "object",
      "required": ["tool", "version"],
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["runner", "os"],
      "properties": {
        "runner": { "type": "string" },
        "os": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["npm"],
      "properties": {
        "npm": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
